# Environment Configuration for E-REDES Bot Frontend

# API Configuration
REACT_APP_API_URL=http://localhost:3001/api
REACT_APP_API_TIMEOUT=120000

# Application Configuration
REACT_APP_NAME="E-REDES Bot"
REACT_APP_VERSION="1.0.0"
REACT_APP_DESCRIPTION="Simulação inteligente de faturas de eletricidade"

# Feature Flags
REACT_APP_ENABLE_PWA=true
REACT_APP_ENABLE_SERVICE_WORKER=true
REACT_APP_ENABLE_ANALYTICS=false

# Development Configuration
REACT_APP_ENV=development
GENERATE_SOURCEMAP=true
FAST_REFRESH=true

# Build Configuration
PUBLIC_URL=.
BUILD_PATH=build

# Browser Configuration
BROWSER=default
BROWSER_ARGS=

# Port Configuration (opcional, default é 3000)
# PORT=3000

# HTTPS Configuration (para desenvolvimento local com HTTPS)
# HTTPS=false
# SSL_CRT_FILE=
# SSL_KEY_FILE=

# Performance Monitoring
REACT_APP_WEB_VITALS_ENABLED=true

# Debug Configuration
REACT_APP_DEBUG_MODE=true
REACT_APP_CONSOLE_LOGS=true